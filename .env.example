# Copy to .env and fill in. NEVER commit .env.

# --- Webex (developer.webex.com -> My Webex Apps -> Create a Bot) ---
WEBEX_BOT_TOKEN=
# any random string; Webex signs every webhook with it and Tony verifies the signature
WEBEX_WEBHOOK_SECRET=
# optional: temporary public HTTPS URL reaching your local machine (e.g. ngrok / cloudflared tunnel), no trailing slash.
# If set, Tony automatically registers and self-heals its Webex webhook during local testing.
PUBLIC_URL=

# --- Storage ---
DATA_DIR=./data
WORKBOOK_NAME=testcases.xlsx
# optional: link to the shared copy of the workbook (OneDrive/SharePoint); added to replies
WORKBOOK_URL=
TZ=Asia/Kolkata

# --- Behaviour (defaults shown) ---
BACKUPS_KEEP=20
DUPLICATE_THRESHOLD=0.60
SEARCH_THRESHOLD=0.50
LOCK_RETRY_SECONDS=10
LOCK_MAX_WAIT_SECONDS=900
PENDING_TTL_SECONDS=900
MAX_ATTACHMENT_MB=10
MASK_EMAILS=false

# --- Ops ---
PORT=8080
LOG_LEVEL=INFO
# optional dead-man's-switch URL (healthchecks.io / Uptime Kuma push monitor): Tony pings it every 5 min,
# the service alerts you when the pings stop (i.e. Tony or its host is down)
HEALTHCHECK_PING_URL=
